// Minimal setFunction() usage - defines two custom GLSL functions at
// runtime (a source and a color effect), the same way a pasted-in
// community shader snippet would, then uses them like any built-in.
// See SPEC.md section 12 and README.md's "Custom GLSL functions" section
// for the full details/limitations.
//
// Run: cargo run --bin hydra -- examples/setfunction_basic.hydra

// type: 'src' - a source function, called with no chain in front of it.
// `st` (the screen coordinate) and one float per declared input are
// available in the GLSL body; `time` is rewritten to this project's
// `iTime` uniform automatically.
setFunction({
  name: 'gradient2',
  type: 'src',
  inputs: [{type: 'float', name: 'speed', default: 0.2}],
  glsl: `return vec4(sin(speed * time) * 0.5 + 0.5, st, 1.0);`
});

// type: 'color' - a color function, called on an existing chain's
// current color (`c0`) plus its own declared inputs.
setFunction({
  name: 'invert2',
  type: 'color',
  inputs: [{type: 'float', name: 'amount', default: 1.0}],
  glsl: `return mix(c0, vec4(1.0 - c0.rgb, c0.a), amount);`
});

gradient2(0.3)
  .invert2(0.8)
  .out()
